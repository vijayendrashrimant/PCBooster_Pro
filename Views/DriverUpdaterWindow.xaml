<Window x:Class="PCBooster.Views.DriverUpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Driver Updater — PC Booster Pro"
        Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinWidth="700" MinHeight="440">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#16213E"/>
            <Setter Property="BorderBrush"     Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background"     Value="#0D1117"/>
            <Setter Property="Foreground"     Value="#9FA8C0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"    Value="#2D3561"/>
            <Setter Property="Padding"        Value="8,6"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="DriverRow" TargetType="ListViewItem">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="#E8EAF6"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Padding"        Value="4,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"    Value="#1A2A40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="#0D1117" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Driver Updater" Foreground="#E8EAF6"
                                   FontSize="15" FontWeight="Medium"/>
                        <TextBlock x:Name="SubLabel" Text="Scanning installed drivers…"
                                   Foreground="#9FA8C0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#16213E" BorderBrush="#2D3561" BorderThickness="1"
                            CornerRadius="6" Margin="0,0,8,0" Padding="10,6">
                        <Grid>
                            <TextBlock Text="Filter…" Foreground="#4A5568" FontSize="12"
                                       x:Name="FilterHint" IsHitTestVisible="False"/>
                            <TextBox x:Name="FilterBox" Background="Transparent" Foreground="#E8EAF6"
                                     BorderThickness="0" FontSize="12" Width="140"
                                     TextChanged="FilterBox_TextChanged"
                                     GotFocus="FilterBox_GotFocus"
                                     LostFocus="FilterBox_LostFocus"/>
                        </Grid>
                    </Border>
                    <Button Content="⚙  Device Manager" Click="DevManager_Click"
                            Background="#1E2A4A" Foreground="#9FA8C0" BorderBrush="#2D3561"
                            BorderThickness="1" Padding="10,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#1A3560"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="🔄  Check Updates" Click="WindowsUpdate_Click"
                            Background="#1A6FAD" Foreground="White" BorderThickness="0"
                            Padding="10,6" FontSize="12" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#155A8F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary tiles -->
        <Grid Grid.Row="1" Background="#0F1620">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#2D3561" BorderThickness="0,0,1,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="TOTAL" Foreground="#4A5568" FontSize="10"/>
                    <TextBlock x:Name="TotalLabel" Text="—" Foreground="#E8EAF6" FontSize="20" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="#2D3561" BorderThickness="0,0,1,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="OUTDATED (&gt;2 YRS)" Foreground="#4A5568" FontSize="10"/>
                    <TextBlock x:Name="OutdatedLabel" Text="—" Foreground="#FEBC2E" FontSize="20" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" BorderBrush="#2D3561" BorderThickness="0,0,1,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="HAS ISSUES" Foreground="#4A5568" FontSize="10"/>
                    <TextBlock x:Name="IssueLabel" Text="—" Foreground="#FF5F57" FontSize="20" FontWeight="Medium"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" BorderBrush="#2D3561" BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel>
                    <TextBlock Text="UP TO DATE" Foreground="#4A5568" FontSize="10"/>
                    <TextBlock x:Name="OkLabel" Text="—" Foreground="#28C840" FontSize="20" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Driver List -->
        <ListView x:Name="DriverList" Grid.Row="2"
                  Background="#1A1A2E" Foreground="#E8EAF6"
                  BorderThickness="0"
                  ItemContainerStyle="{StaticResource DriverRow}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                    <GridViewColumn Header="" Width="30"
                                    DisplayMemberBinding="{Binding ClassIcon}"/>
                    <GridViewColumn Header="Device" Width="220"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Class" Width="110"
                                    DisplayMemberBinding="{Binding DeviceClass}"/>
                    <GridViewColumn Header="Version" Width="110"
                                    DisplayMemberBinding="{Binding Version}"/>
                    <GridViewColumn Header="Date" Width="90"
                                    DisplayMemberBinding="{Binding DateDisplay}"/>
                    <GridViewColumn Header="Status" Width="80"
                                    DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🔍 Search" Tag="{Binding}"
                                        Click="SearchDriver_Click"
                                        Background="#1E2A4A" Foreground="#9FA8C0"
                                        BorderBrush="#2D3561" BorderThickness="1"
                                        Padding="6,3" FontSize="11" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#1A3560"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="#0D1117" Padding="16,8"
                BorderBrush="#2D3561" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Ready"
                       Foreground="#4A5568" FontSize="11"/>
        </Border>
    </Grid>
</Window>
