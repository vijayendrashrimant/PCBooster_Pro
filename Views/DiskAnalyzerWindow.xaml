<Window x:Class="PCBooster.Views.DiskAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PCBooster.Views"
        Title="Disk Analyzer — PC Booster Pro"
        Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinWidth="700" MinHeight="460">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#16213E"/>
            <Setter Property="BorderBrush"     Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14"/>
        </Style>
        <Style x:Key="ColHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background"     Value="#0D1117"/>
            <Setter Property="Foreground"     Value="#9FA8C0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"    Value="#2D3561"/>
            <Setter Property="Padding"        Value="8,5"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ListRow" TargetType="ListViewItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#E8EAF6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="4,5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush"     Value="#1A2A40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E2A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💿" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Disk Analyzer" Foreground="#E8EAF6" FontSize="16" FontWeight="Medium"/>
                    <TextBlock x:Name="SubLabel" Text="Scanning drives…"
                               Foreground="#9FA8C0" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ComboBox x:Name="DriveCombo" Background="#16213E" Foreground="#9FA8C0"
                          BorderBrush="#2D3561" FontSize="12" Margin="0,0,8,0" MinWidth="120"
                          SelectionChanged="DriveCombo_Changed"/>
                <Button Content="🔍  Scan Folders" Click="ScanFolders_Click"
                        Background="#1A6FAD" Foreground="White" BorderThickness="0"
                        Padding="12,7" FontSize="12" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#155A8F"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Background" Value="#0D2A40"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Drive cards -->
        <StackPanel x:Name="DriveCardsPanel" Grid.Row="1"
                    Orientation="Horizontal" Margin="0,0,0,12"/>

        <!-- Main content: folder list + file type chart -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Largest folders list -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Largest Folders" Foreground="#E8EAF6"
                               FontSize="13" FontWeight="Medium" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1" x:Name="FolderPlaceholder">
                        <TextBlock Text="Select a drive and click Scan Folders to begin."
                                   Foreground="#4A5568" FontSize="13"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                    <ListView x:Name="FolderList" Grid.Row="1"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#E8EAF6" Visibility="Collapsed"
                              ItemContainerStyle="{StaticResource ListRow}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ColHeader}">
                                <GridViewColumn Header="#"     Width="30"  DisplayMemberBinding="{Binding Path=., Converter={x:Static local:IndexConverter.Instance}}"/>
                                <GridViewColumn Header="Folder" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Size"   Width="90"  DisplayMemberBinding="{Binding Display}"/>
                                <GridViewColumn Header="Path"   Width="200" DisplayMemberBinding="{Binding Path}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <!-- File type chart -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Space by File Type" Foreground="#E8EAF6"
                               FontSize="13" FontWeight="Medium" Margin="0,0,0,12"/>
                    <StackPanel x:Name="ExtPanel"/>
                    <TextBlock x:Name="ExtPlaceholder"
                               Text="Run a scan to see file type breakdown."
                               Foreground="#4A5568" FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Text="Ready" Foreground="#4A5568" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
