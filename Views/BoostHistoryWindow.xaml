<Window x:Class="PCBooster.Views.BoostHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boost History — PC Booster Pro"
        Height="560" Width="740"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinWidth="560" MinHeight="380">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#16213E"/>
            <Setter Property="BorderBrush"     Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="🚀" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Boost History" Foreground="#E8EAF6" FontSize="16" FontWeight="Medium"/>
                <TextBlock x:Name="SubLabel" Text="Loading…" Foreground="#9FA8C0" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Stats row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="TOTAL BOOSTS" Foreground="#9FA8C0" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TotalBoosts" Text="0" Foreground="#4FA3E0"
                               FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="AVG SCORE GAIN" Foreground="#9FA8C0" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AvgGain" Text="+0 pts" Foreground="#28C840"
                               FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="BEST BOOST" Foreground="#9FA8C0" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="BestGain" Text="+0 pts" Foreground="#FEBC2E"
                               FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- History list -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Boost Log" Foreground="#E8EAF6"
                           FontSize="13" FontWeight="Medium" Margin="0,0,0,12"/>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="EmptyLabel"
                               Text="No boosts recorded yet. Run your first boost from the Dashboard."
                               Foreground="#4A5568" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel x:Name="HistoryPanel"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Text="" Foreground="#4A5568" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
