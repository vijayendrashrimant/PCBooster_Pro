<Window x:Class="PCBooster.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About — PC Booster Pro"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="NoResize">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo + name -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Border Width="64" Height="64" Background="#1A6FAD" CornerRadius="16"
                    HorizontalAlignment="Center" Margin="0,0,0,12">
                <TextBlock Text="⚡" FontSize="34" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="PC Booster Pro" Foreground="#E8EAF6"
                       FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Version 2.5.0  ·  .NET 6 / WPF" Foreground="#9FA8C0"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Row="2" Background="#2D3561" Height="1"/>

        <!-- Feature summary -->
        <Border Grid.Row="4" Background="#16213E" BorderBrush="#2D3561"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="FEATURES" Foreground="#9FA8C0" FontSize="10"
                           FontWeight="Medium" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Border x:Name="b" Margin="0,0,6,6"/>
                </WrapPanel>
                <StackPanel x:Name="FeatureList" Orientation="Vertical"/>
                <Separator Background="#2D3561" Margin="0,12"/>
                <TextBlock Text="Built with C# · WPF · .NET 6 · System.Management (WMI)"
                           Foreground="#4A5568" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0"
                           Foreground="#4A5568" FontSize="11">
                    Data stored in <Run Foreground="#4FA3E0">%AppData%\PCBoosterPro</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Close button -->
        <Button Grid.Row="5" Content="Close" Click="Close_Click"
                Background="#1A6FAD" Foreground="White" BorderThickness="0"
                Padding="0,9" FontSize="13" Cursor="Hand"
                HorizontalAlignment="Center" Width="120" Margin="0,14,0,0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" Width="{TemplateBinding Width}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#155A8F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
