<Window x:Class="PCBooster.Views.PerformanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Performance — PC Booster Pro"
        Height="640" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinWidth="760" MinHeight="460">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#16213E"/>
            <Setter Property="BorderBrush"     Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14"/>
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9FA8C0"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#E8EAF6"/>
            <Setter Property="FontSize"    Value="24"/>
            <Setter Property="FontWeight"  Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Live Performance Monitor" Foreground="#E8EAF6"
                           FontSize="15" FontWeight="Medium"/>
                <TextBlock x:Name="SubLabel" Text="Polling every 1 second"
                           Foreground="#9FA8C0" FontSize="11"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Rectangle Width="12" Height="3" Fill="#4FA3E0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="CPU" Foreground="#9FA8C0" FontSize="11" Margin="0,0,10,0"/>
                <Rectangle Width="12" Height="3" Fill="#28C840" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="RAM" Foreground="#9FA8C0" FontSize="11" Margin="0,0,10,0"/>
                <Rectangle Width="12" Height="3" Fill="#FEBC2E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Disk" Foreground="#9FA8C0" FontSize="11" Margin="0,0,10,0"/>
                <Rectangle Width="12" Height="3" Fill="#AA7FFF" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="GPU" Foreground="#9FA8C0" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <!-- Stat tiles -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CPU" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="CpuTile"  Text="—%" Style="{StaticResource MetricValue}" Foreground="#4FA3E0"/>
                    <ProgressBar x:Name="CpuTileBar" Height="4" Maximum="100" Background="#2D3561"
                                 Foreground="#4FA3E0" BorderThickness="0" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="RAM" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="RamTile"  Text="—%" Style="{StaticResource MetricValue}" Foreground="#28C840"/>
                    <ProgressBar x:Name="RamTileBar" Height="4" Maximum="100" Background="#2D3561"
                                 Foreground="#28C840" BorderThickness="0" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="DISK" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="DiskTile" Text="—%" Style="{StaticResource MetricValue}" Foreground="#FEBC2E"/>
                    <ProgressBar x:Name="DiskTileBar" Height="4" Maximum="100" Background="#2D3561"
                                 Foreground="#FEBC2E" BorderThickness="0" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="GPU" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="GpuTile"  Text="—%" Style="{StaticResource MetricValue}" Foreground="#AA7FFF"/>
                    <ProgressBar x:Name="GpuTileBar" Height="4" Maximum="100" Background="#2D3561"
                                 Foreground="#AA7FFF" BorderThickness="0" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TEMP" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="TempTile" Text="—°C" Style="{StaticResource MetricValue}" Foreground="#FF5F57"/>
                    <ProgressBar x:Name="TempTileBar" Height="4" Maximum="100" Background="#2D3561"
                                 Foreground="#FF5F57" BorderThickness="0" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="10" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="NETWORK ↓" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="NetTile"  Text="— Mbps" Foreground="#00D2D3"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="NetUpTile" Text="↑ — Mbps" Foreground="#4A5568" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Live multi-line chart -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Live Resource Usage — last 60 seconds"
                               Foreground="#E8EAF6" FontSize="13" FontWeight="Medium"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="AlertBanner" Text="" Foreground="#FF5F57"
                                   FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Canvas x:Name="PerfGraph" Grid.Row="1" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Text="Starting monitor…" Foreground="#4A5568"
                   FontSize="11" Margin="0,8,0,0"/>
    </Grid>
</Window>
