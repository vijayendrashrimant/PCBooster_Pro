<Window x:Class="PCBooster.Views.SchedulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scheduled Tasks — PC Booster Pro"
        Height="560" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#16213E"/>
            <Setter Property="BorderBrush"     Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Margin"          Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"     Value="#1A6FAD"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="14,8"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#155A8F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#0D2A40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="🕐" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="Scheduled Tasks" Foreground="#E8EAF6" FontSize="16" FontWeight="Medium"/>
                <TextBlock Text="Automate boosts via Windows Task Scheduler"
                           Foreground="#9FA8C0" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- Create new task -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="➕  CREATE SCHEDULE" Foreground="#9FA8C0" FontSize="10" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Frequency:" Foreground="#E8EAF6" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="FreqCombo" Grid.Column="1" Background="#0D1830"
                              Foreground="#E8EAF6" BorderBrush="#2D3561" FontSize="12"
                              SelectionChanged="FreqCombo_Changed">
                        <ComboBoxItem Content="Daily"   IsSelected="True"/>
                        <ComboBoxItem Content="Weekly"/>
                        <ComboBoxItem Content="On Startup"/>
                    </ComboBox>
                </Grid>

                <Grid x:Name="TimeRow" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Time:" Foreground="#E8EAF6" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Grid.Column="1" Background="#0D1830" BorderBrush="#2D3561"
                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HourBox" Text="08" Width="28" Background="Transparent"
                                     Foreground="#E8EAF6" BorderThickness="0" FontSize="13"
                                     TextAlignment="Center" MaxLength="2"/>
                            <TextBlock Text=":" Foreground="#9FA8C0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBox x:Name="MinBox"  Text="00" Width="28" Background="Transparent"
                                     Foreground="#E8EAF6" BorderThickness="0" FontSize="13"
                                     TextAlignment="Center" MaxLength="2"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="DayRow" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Day:" Foreground="#E8EAF6" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="DayCombo" Grid.Column="1" Background="#0D1830"
                              Foreground="#E8EAF6" BorderBrush="#2D3561" FontSize="12">
                        <ComboBoxItem Content="Monday"    IsSelected="True"/>
                        <ComboBoxItem Content="Tuesday"/>
                        <ComboBoxItem Content="Wednesday"/>
                        <ComboBoxItem Content="Thursday"/>
                        <ComboBoxItem Content="Friday"/>
                        <ComboBoxItem Content="Saturday"/>
                        <ComboBoxItem Content="Sunday"/>
                    </ComboBox>
                </Grid>

                <Button Content="✓  Create Task" Style="{StaticResource PrimaryBtn}"
                        HorizontalAlignment="Left" Click="CreateTask_Click"/>
            </StackPanel>
        </Border>

        <!-- Existing tasks -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="📋  ACTIVE TASKS" Foreground="#9FA8C0" FontSize="10" VerticalAlignment="Center"/>
                    <Button Content="↻ Refresh" Click="RefreshTasks_Click" HorizontalAlignment="Right"
                            Background="#1E2A4A" Foreground="#9FA8C0" BorderBrush="#2D3561"
                            BorderThickness="1" Padding="8,4" FontSize="11" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <StackPanel x:Name="TasksPanel"/>
                <TextBlock x:Name="NoTasksLabel"
                           Text="No scheduled tasks yet. Create one above."
                           Foreground="#4A5568" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="4"
                   Text="Note: Tasks require administrator privileges to create."
                   Foreground="#4A5568" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</Window>
