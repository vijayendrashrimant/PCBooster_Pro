<Window x:Class="PCBooster.Views.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts — PC Booster Pro"
        Height="500" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanMinimize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔔" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="Alert History" Foreground="#E8EAF6" FontSize="16" FontWeight="Medium"/>
                    <TextBlock x:Name="SubLabel" Text="Threshold breaches in the last 24 hours"
                               Foreground="#9FA8C0" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <Button Content="Dismiss All" Click="DismissAll_Click"
                    Background="#1E2A4A" Foreground="#9FA8C0" BorderBrush="#2D3561"
                    BorderThickness="1" Padding="12,6" FontSize="12" Cursor="Hand"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A3560"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Alert list -->
        <Border Grid.Row="1" Background="#16213E" BorderBrush="#2D3561"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <TextBlock x:Name="EmptyLabel"
                           Text="✅  No alerts in the last 24 hours."
                           Foreground="#4A5568" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer x:Name="AlertScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel x:Name="AlertPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Text="" Foreground="#4A5568"
                   FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
