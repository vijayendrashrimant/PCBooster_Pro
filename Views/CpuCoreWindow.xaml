<Window x:Class="PCBooster.Views.CpuCoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPU Core Monitor — PC Booster Pro"
        Height="580" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="CanResize"
        MinWidth="600" MinHeight="400">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#16213E"/>
            <Setter Property="BorderBrush"     Value="#2D3561"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="16"/>
        </Style>
        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="🖥" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock x:Name="CpuNameLabel" Text="CPU Core Monitor"
                           Foreground="#E8EAF6" FontSize="16" FontWeight="Medium"/>
                <TextBlock x:Name="CpuSubLabel" Text="Reading core data…"
                           Foreground="#9FA8C0" FontSize="12"/>
            </StackPanel>
            <Border Background="#1A3560" BorderBrush="#2D5099" BorderThickness="1"
                    CornerRadius="6" Padding="12,5" Margin="16,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Polling: " Foreground="#9FA8C0" FontSize="12"/>
                    <TextBlock x:Name="PollRateLabel" Text="1s" Foreground="#4FA3E0" FontSize="12" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main grid: core heatmap + side info -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- Core Heatmap -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Per-Core Usage" Foreground="#E8EAF6"
                               FontSize="13" FontWeight="Medium" Margin="0,0,0,12"/>

                    <!-- Core tiles (built in code-behind) -->
                    <WrapPanel x:Name="CoreTilesPanel" Grid.Row="1"
                               ItemWidth="100" ItemHeight="90"/>

                    <!-- Legend -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Low" Foreground="#28C840" FontSize="11"/>
                        <Border Width="80" Height="8" Margin="6,0" VerticalAlignment="Center" CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#28C840" Offset="0"/>
                                    <GradientStop Color="#FEBC2E" Offset="0.5"/>
                                    <GradientStop Color="#FF5F57" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="High" Foreground="#FF5F57" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right panel: CPU info + total + history bars -->
            <StackPanel Grid.Column="2">

                <!-- Overall CPU -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="OVERALL CPU" Foreground="#9FA8C0" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock x:Name="OverallCpuVal" Text="—%" Foreground="#4FA3E0"
                                   FontSize="32" FontWeight="Bold"/>
                        <ProgressBar x:Name="OverallCpuBar" Height="6" Maximum="100" Value="0"
                                     Background="#2D3561" Foreground="#4FA3E0"
                                     BorderThickness="0" Margin="0,8,0,4"/>
                        <Grid>
                            <TextBlock x:Name="CoreCountLabel" Text="— cores" Foreground="#9FA8C0" FontSize="11"/>
                            <TextBlock x:Name="FreqLabel" Text="— GHz" Foreground="#9FA8C0"
                                       FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CPU Specs -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="CPU DETAILS" Foreground="#9FA8C0" FontSize="11" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Physical Cores" Foreground="#9FA8C0" FontSize="12"/>
                            <TextBlock x:Name="PhysCores" Text="—" Foreground="#E8EAF6"
                                       FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Logical Cores" Foreground="#9FA8C0" FontSize="12"/>
                            <TextBlock x:Name="LogCores" Text="—" Foreground="#E8EAF6"
                                       FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Base Speed" Foreground="#9FA8C0" FontSize="12"/>
                            <TextBlock x:Name="BaseSpeed" Text="—" Foreground="#E8EAF6"
                                       FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="L2 Cache" Foreground="#9FA8C0" FontSize="12"/>
                            <TextBlock x:Name="L2Cache" Text="—" Foreground="#E8EAF6"
                                       FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="L3 Cache" Foreground="#9FA8C0" FontSize="12"/>
                            <TextBlock x:Name="L3Cache" Text="—" Foreground="#E8EAF6"
                                       FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Socket" Foreground="#9FA8C0" FontSize="12"/>
                            <TextBlock x:Name="Socket" Text="—" Foreground="#E8EAF6"
                                       FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hottest Core -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🔥  HOTTEST CORE" Foreground="#9FA8C0" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock x:Name="HottestCore" Text="Core —  at  —%"
                                   Foreground="#FF5F57" FontSize="14" FontWeight="Medium"/>
                        <Separator Background="#2D3561" Margin="0,8"/>
                        <TextBlock Text="❄  COOLEST CORE" Foreground="#9FA8C0" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CoolestCore" Text="Core —  at  —%"
                                   Foreground="#28C840" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="2"
                   Text="Reading core usage…"
                   Foreground="#4A5568" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
